rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile document.
    match /Users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Habits: owner-only access (NFR-SEC-02).
    match /Habits/{habitId} {
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // HabitLogs: owner-only access, same pattern as Habits.
    match /HabitLogs/{logId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // QuizQuestions: public read (content library), writes restricted to admins.
    match /QuizQuestions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // manage via Firebase console / admin SDK only
    }

    // QuizResults: owner-only.
    match /QuizResults/{resultId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // LearnProgress: owner-only, same create-then-repeatedly-update
    // lifecycle as HabitLogs (a topic's doc is created on the first lesson
    // question and merged into on every one after, not create-once).
    match /LearnProgress/{progressId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // PrayerLogs: owner-only, one doc per user per prayer day, merged into
    // as each prayer is logged. Reads are always a uid-pinned query (see
    // FirestoreService.watchPrayerLog), since a get of a not-yet-created
    // day would have no resource.data.uid to check.
    match /PrayerLogs/{logId} {
      allow read, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // DailyQuotes: public read-only content library.
    match /DailyQuotes/{quoteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // PrayerCache: shared cache, readable by any authenticated user.
    match /PrayerCache/{cacheId} {
      allow read, write: if request.auth != null;
    }

    // Notifications & Settings: owner-only.
    match /Notifications/{docId} {
      allow read, write: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
    match /Settings/{docId} {
      allow read, write: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
