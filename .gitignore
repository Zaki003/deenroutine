# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.iml

# Android
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/*.jks
android/**/GeneratedPluginRegistrant.java

# iOS
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/.symlinks/
**/xcuserdata/

# VS Code / IDE
.vscode/
.idea/

# Claude Code (local-only; machine-specific permissions/lock state)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# macOS
.DS_Store

# Node (content seeding scripts)
node_modules/

# Firebase emulator (scripts/test_firestore_rules.js)
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Service account key for scripts/seed_quiz_questions.js — NEVER commit this,
# it grants full admin access to the Firebase project.
scripts/serviceAccountKey.json
**/*serviceAccountKey*.json
**/*-firebase-adminsdk-*.json

# Raw GeoNames dumps for scripts/build_cities_asset.js — large source files,
# not needed at runtime (only their trimmed output, assets/cities.json, is).
scripts/.geonames-raw/

# Firebase (do NOT commit real credentials — regenerate locally via
# `flutterfire configure` instead; see the implementation guide, Step 3)
# lib/firebase_options.dart is intentionally kept OUT of this ignore list —
# for a client-side Flutter app, these values are not secret (they're
# baked into every APK anyway); real protection comes from Firestore
# security rules and App Check, not from hiding this file.
